rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /moodlePublicCourses/{courseId} {
      allow read: if resource.data.isPublic == true;
      allow write: if false;
    }

    match /raags/{raagId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();

      match /topics/{topicId} {
        allow read: if resource.data.requiresLogin != true || signedIn() || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /practiceLoops/{loopId} {
        allow read: if isAdmin() || (
          get(/databases/$(database)/documents/raags/$(raagId)).data.isPublished == true
          && resource.data.isPublished == true
          && (resource.data.accessLevel == 'public'
            || (resource.data.accessLevel == 'signed-in' && signedIn()))
        );
        allow create, update, delete: if isAdmin();
      }
    }

    match /users/{uid}/practiceLoops/{loopId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.sourceType in ['youtube', 'audio']
        && request.resource.data.get('songName', '').size() <= 100
        && request.resource.data.get('raagName', '').size() <= 60
        && request.resource.data.get('notes', '').size() <= 5000;
    }

    match /raagSourceRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /compositionDatasets/{datasetId} {
      allow read, create, update, delete: if isAdmin();

      match /records/{recordId} {
        allow read, create, update, delete: if isAdmin();
      }
    }
  }
}